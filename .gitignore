# Only the playable GitHub Pages build is published.
/*
!/.gitignore
!/.nojekyll
!/index.html
!/pixxo.html
!/assets/

/assets/*
!/assets/css/
!/assets/js/
!/assets/music/
!/assets/sprites/
!/assets/ui/
